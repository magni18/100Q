{
  "expo": {
    "name": "100 Questions",
    "slug": "hundred-questions",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon-760x760.png",
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/images/icon-400x240.png"
        }
      ]
